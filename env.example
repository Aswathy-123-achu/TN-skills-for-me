# Required for Gemini-powered features
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: choose another Gemini model if your account supports it
GEMINI_MODEL=gemini-2.5-flash

# Keep false for the easiest setup. Set true only after installing
# the optional torch/transformers packages.
ENABLE_LOCAL_EXPLAINER=false
LOCAL_EXPLAINER_MODEL=MBZUAI/LaMini-Flan-T5-783M
